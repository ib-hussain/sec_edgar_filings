# -------------------------------------------------------
# FIN-GLASSBOX  –  .gitattributes
# Git LFS: track large binary & data files only.
# Python source, notebooks, configs → stay in regular Git.
# -------------------------------------------------------
# ── Datasets & serialised model weights ─────────────────
*.csv                                           filter=lfs diff=lfs merge=lfs -text
*results*.txt                                   filter=lfs diff=lfs merge=lfs -text
*.npy                                           filter=lfs diff=lfs merge=lfs -text
*.npz                                           filter=lfs diff=lfs merge=lfs -text
*.parquet                                       filter=lfs diff=lfs merge=lfs -text
*.h5                                            filter=lfs diff=lfs merge=lfs -text
*.hdf5                                          filter=lfs diff=lfs merge=lfs -text
*.pkl                                           filter=lfs diff=lfs merge=lfs -text
*.json                                          filter=lfs diff=lfs merge=lfs -text
*.pt                                            filter=lfs diff=lfs merge=lfs -text
*.pth                                           filter=lfs diff=lfs merge=lfs -text
*.onnx                                          filter=lfs diff=lfs merge=lfs -text
*.safetensor*                                   filter=lfs diff=lfs merge=lfs -text
outputs/models/**/**/*.bin                      filter=lfs diff=lfs merge=lfs -text
transfer_artifacts/*.tar.zst                    filter=lfs diff=lfs merge=lfs -text

# ── Compressed archives ──────────────────────────────────
data/*.zip          filter=lfs diff=lfs merge=lfs binary
*.tar.gz            filter=lfs diff=lfs merge=lfs binary
*.tar.bz2           filter=lfs diff=lfs merge=lfs binary
*.gz                filter=lfs diff=lfs merge=lfs binary
# ── Figures & media ──────────────────────────────────────
# *.png           filter=lfs diff=lfs merge=lfs -text
# *.jpg           filter=lfs diff=lfs merge=lfs -text
# *.jpeg          filter=lfs diff=lfs merge=lfs -text
*.svg           filter=lfs diff=lfs merge=lfs -text
# ── Line-ending normalisation for text files ────────────
# Automatically detect text files and normalize line endings to LF on commit
* text=auto
# Explicitly enforce LF line endings for cross-platform code consistency
*.py            text 
*.toml          text 
*.ipynb         text 
*.txt           text
*.md            text
*.json          text
*.xml           text
*.yaml          text
*.yml           text
*.html          text
*.css           text
*.js            text
*.ts            text
*.tsx           text
*.jsx           text
# Force LF for shell scripts to prevent execution failure on Unix systems
*.sh            text eol=lf
*.bat           text eol=crlf
*.cmd           text eol=crlf
# Prevent Git from modifying or converting line endings in binary assets
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
# Keep repository metadata out of release archives (e.g., git archive)
.gitattributes  export-ignore
.gitignore      export-ignore
.github/        export-ignore
